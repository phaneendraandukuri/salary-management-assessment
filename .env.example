# Optional API port; defaults to 3000.
PORT=3000
# Exact frontend origin; localhost and 127.0.0.1 are different origins.
APP_ORIGIN=http://127.0.0.1:5173
# HR_USERNAME, HR_PASSWORD_HASH and SESSION_SECRET must be supplied privately.
# Local Homebrew PostgreSQL uses the current OS user by default.
# Export these values for database commands; this file is documentation, not auto-loaded.
DATABASE_URL=postgresql://localhost:5432/acme
TEST_DATABASE_URL=postgresql://localhost:5432/acme_test
