{
  "name": "acme-salary-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @acme/api",
    "dev:web": "npm run dev --workspace @acme/web",
    "test": "npm run test --workspaces",
    "test:watch": "npm run test:watch --workspace @acme/api",
    "test:integration": "npm run test:integration --workspace @acme/api",
    "db:migrate": "npm run db:migrate --workspace @acme/api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,html,json}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,html,json}\" \"*.{js,json}\"",
    "build": "npm run build --workspaces",
    "start:api": "npm run start --workspace @acme/api",
    "preview:web": "npm run preview --workspace @acme/web",
    "db:seed": "npm run db:seed --workspace @acme/api",
    "auth:hash": "npm run auth:hash --workspace @acme/api --"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
